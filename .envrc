use flake

# Stable toolchain for IDEs (RustRover: Settings > Rust > Toolchain location =
# <project>/.direnv/rust-toolchain/bin). An IDE is one long-lived process shared
# by many projects, so it cannot inherit this project's environment. Instead each
# tool here is a tiny wrapper that runs the real one inside `direnv exec`, so cc
# hamlib and the rest are present however the IDE was started. .direnv is
# gitignored and regenerated on every load.
tc="$PWD/.direnv/rust-toolchain"
direnv_bin=${direnv:-$(command -v direnv)}  # stdlib sets $direnv to its own absolute path
rm -rf "$tc"
mkdir -p "$tc/bin" "$tc/lib/rustlib/src/rust"
for tool in cargo rustc rustfmt cargo-clippy clippy-driver rust-analyzer; do
  if real=$(command -v "$tool"); then
    printf '#!/bin/sh\nexec %q exec %q %q "$@"\n' "$direnv_bin" "$PWD" "$real" > "$tc/bin/$tool"
    chmod +x "$tc/bin/$tool"
  fi
done
[ -n "${RUST_SRC_PATH:-}" ] && ln -s "$RUST_SRC_PATH" "$tc/lib/rustlib/src/rust/library"
